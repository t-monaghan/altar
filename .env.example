# The IP address of the awtrix device, if you're using the request logger you can leave this blank
AWTRIX_IP=""
# The latitiude/longitude and timezone options define the location of the clock for weather based information.
# see: https://github.com/t-monaghan/altar/tree/main/examples/weather
LATITUDE="-37.814"
LONGITUDE="144.9633"
WEATHER_TIMEZONE="Australia/Sydney"
# This is the secret for your stargazer webhook
STARGAZER_WEBHOOK_SECRET=""
